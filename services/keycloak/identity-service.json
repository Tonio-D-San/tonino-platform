{
  "realm": "${KEYCLOAK_REALM_NAME}",
  "displayName": "${APP_ID}",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "groups": [
    {
      "name": "platform-users"
    },
    {
      "name": "platform-admins"
    }
  ],
  "clientScopes": [
    {
      "name": "${KEYCLOAK_CLIENT_ID}-audience",
      "description": "Adds ${KEYCLOAK_CLIENT_ID} to access-token audiences",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "${KEYCLOAK_CLIENT_ID}-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "${KEYCLOAK_CLIENT_ID}",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],

  "clients": [
    {
      "clientId": "${KC_ADMIN_CLIENT_ID}",
      "name": "${APP_ID} Backend",
      "description": "Technical client used by the Platform backend",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_ADMIN_CLIENT_SECRET}",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "${KEYCLOAK_CLIENT_ID}-audience"
      ]
    },
    {
      "clientId": "${KEYCLOAK_CLIENT_ID}",
      "name": "${APP_ID} API",
      "description": "Platform REST API audience",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "${KEYCLOAK_APP_CLIENT_ID}",
      "name": "${APP_ID} Swagger",
      "description": "Public client for Swagger UI development login",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${APPLICATION_URL}/swagger-ui/oauth2-redirect.html",
        "${APPLICATION_URL}/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "${APPLICATION_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "${KEYCLOAK_CLIENT_ID}-audience"
      ],
      "protocolMappers": [
        {
          "name": "platform-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "${KEYCLOAK_CONSOLE_CLIENT_ID}",
      "name": "${APP_ID} Console",
      "description": "Public client for the Identity web console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${FRONTEND_URL}",
        "${FRONTEND_URL}/*"
      ],
      "webOrigins": [
        "${FRONTEND_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${FRONTEND_URL}##${FRONTEND_URL}/*"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "${KEYCLOAK_CLIENT_ID}-audience"
      ],
      "protocolMappers": [
        {
          "name": "platform-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-${KC_ADMIN_CLIENT_ID}",
      "enabled": true,
      "serviceAccountClientId": "${KC_ADMIN_CLIENT_ID}",
      "clientRoles": {
        "realm-management": [
          "manage-users"
        ]
      }
    },
    {
      "username": "tonino",
      "enabled": true,
      "firstName": "Anto",
      "lastName": "Nio",
      "email": "anto@nio.com",
      "emailVerified": true,
      "groups": [
        "/platform-users"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "Password@0",
          "temporary": false
        }
      ]
    }
  ]
}





