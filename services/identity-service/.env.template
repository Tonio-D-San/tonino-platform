APP_ID=identity-service
# Copy to .env.dev or .env.prod; never commit real credentials.
SPRING_PROFILES_ACTIVE=dev
APPLICATION_URL=http://localhost:8082
SERVER_PORT=8082
CORS_ALLOWED_ORIGINS=http://localhost:8082
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_PEOPLE_USER=people_user_dev
DB_PEOPLE_PASSWORD=
DB_PEOPLE_NAME=people_db_dev
KC_DB_USER=kc_db_user_dev
KC_DB_PASSWORD=
KC_DB_NAME=kc_db_dev
KEYCLOAK_URL=http://keycloak.localhost:5443
KEYCLOAK_PORT=5443
# KEYCLOAK_REALM_NAME= # Optional override; defaults derived from APP_ID
# KEYCLOAK_CLIENT_ID= # Optional override; defaults derived from APP_ID
# KEYCLOAK_APP_CLIENT_ID= # Optional override; defaults derived from APP_ID
# KC_ADMIN_CLIENT_ID= # Optional override; defaults derived from APP_ID
PLATFORM_BACKEND_CLIENT_SECRET=
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Optional second trusted issuer; leave empty unless used, distinct from the main issuer.
APPLICATION_ISSUER_NGROK=
MAVEN_SETTINGS_FILE=/absolute/path/to/settings.xml

# Separate frontend origin, e.g. http://localhost:3000; defaults to APPLICATION_URL.
# FRONTEND_URL=
